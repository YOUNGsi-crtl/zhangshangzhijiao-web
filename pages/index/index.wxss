.hero{background:linear-gradient(145deg,#111A67,#2936A0);color:#fff;border-radius:0 0 42rpx 42rpx;padding:42rpx 32rpx 40rpx;margin:-32rpx -32rpx 0}.brand-row{display:flex;align-items:center}.logo{width:72rpx;height:72rpx;border-radius:22rpx;background:#B8D7FF;color:#1A237E;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:800;margin-right:18rpx}.brand{font-size:34rpx;font-weight:800}.sub{font-size:20rpx;opacity:.7;margin-top:4rpx}.avatar{margin-left:auto;width:68rpx;height:68rpx;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center}.greeting{font-size:28rpx;margin-top:48rpx}.hero-stats{display:flex;margin-top:34rpx;justify-content:space-between}.hero-stats view{display:flex;flex-direction:column;gap:4rpx;font-size:20rpx;opacity:.75}.big{font-size:42rpx;font-weight:800;opacity:1}.start-card{margin-top:28rpx}.pulse{width:66rpx;height:66rpx;border-radius:50%;background:#E8EAF6;color:#1A237E;display:flex;align-items:center;justify-content:center;font-weight:800}.start-btn{margin-top:28rpx;height:88rpx;line-height:88rpx}.advice{display:flex;gap:20rpx;align-items:flex-start}.advice-icon{width:60rpx;height:60rpx;border-radius:18rpx;background:#EEF0FF;color:#1A237E;display:flex;align-items:center;justify-content:center;font-size:30rpx}.advice-title{font-weight:700;display:block}.advice-text{display:block;font-size:23rpx;line-height:1.6;margin-top:8rpx}.course-row{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.mini-course{background:#fff;border-radius:24rpx;padding:18rpx;box-shadow:0 12rpx 36rpx rgba(26,35,126,.05);display:flex;flex-direction:column;gap:8rpx}.mini-course text:nth-child(2){font-weight:700}.mini-course text:nth-child(3){font-size:21rpx}.course-art{height:170rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:800;color:#1A237E}.art1{background:#DDEBFF}.art2{background:#E6E3FF}