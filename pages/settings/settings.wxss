.settings{padding:8rpx 28rpx}.setting{display:flex;justify-content:space-between;align-items:center;padding:26rpx 0;border-bottom:1rpx solid #EEF0F4}.setting:last-child{border:0}.setting view{display:flex;flex-direction:column;gap:8rpx}.danger{display:flex;justify-content:space-between;align-items:center;border:1rpx solid #FFE3D1}.danger text:first-child{color:#D95700;font-weight:700}