<view class="training-page">
  <view class="training-top"><text>基础深蹲矫正</text><text class="muted-light">{{elapsed}}s / 60s</text></view>
  <view class="stage">
    <camera device-position="front" class="camera"></camera>
    <view class="demo-label">AI动作参考</view>
    <view class="skeleton" style="left:{{points.head.x}}%;top:{{points.head.y}}%"><view class="sk-head"></view></view>
    <view class="sk-body"></view><view class="sk-arm l"></view><view class="sk-arm r"></view><view class="sk-leg l"></view><view class="sk-leg r"></view>
    <view class="score-float"><text>{{score}}</text><small>动作评分</small></view>
    <view class="feedback {{feedbackClass}}"><text>{{tip}}</text></view>
  </view>
  <view class="live-panel">
    <view class="live-row"><view><text class="label">当前动作</text><text class="value">深蹲</text></view><view><text class="label">完成</text><text class="value">08 / 12</text></view><view><text class="label">稳定性</text><text class="value">93%</text></view></view>
    <view class="progress"><view style="width:{{progress}}%"></view></view>
    <view class="mode-row"><text>● AI实时分析中</text><text>语音 · 骨骼 · 震动</text></view>
  </view>
  <button class="stop" bindtap="finish">结束训练</button>
</view>