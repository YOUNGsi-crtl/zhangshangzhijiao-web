.training-page{min-height:100vh;background:#101741;color:#fff;padding-bottom:40rpx}.training-top{height:110rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:space-between;font-weight:700}.muted-light{color:#9EA8C8;font-size:22rpx}.stage{height:880rpx;margin:0 18rpx;border-radius:34rpx;overflow:hidden;background:#20295C;position:relative}.camera{width:100%;height:100%;opacity:.38}.demo-label{position:absolute;left:24rpx;top:24rpx;background:rgba(255,255,255,.12);border:1rpx solid rgba(255,255,255,.18);padding:10rpx 16rpx;border-radius:999rpx;font-size:20rpx}.skeleton{position:absolute;width:36rpx;height:36rpx}.sk-head{width:36rpx;height:36rpx;border:5rpx solid #8FD2FF;border-radius:50%}.sk-body{position:absolute;left:calc(50% - 4rpx);top:235rpx;width:8rpx;height:260rpx;background:#8FD2FF}.sk-arm{position:absolute;top:310rpx;width:260rpx;height:8rpx;background:#8FD2FF}.sk-arm.l{left:calc(50% - 250rpx);transform:rotate(10deg)}.sk-arm.r{left:50%;transform:rotate(-10deg)}.sk-leg{position:absolute;top:475rpx;width:8rpx;height:260rpx;background:#8FD2FF}.sk-leg.l{left:47%;transform:rotate(5deg)}.sk-leg.r{right:47%;transform:rotate(-5deg)}.score-float{position:absolute;right:24rpx;top:24rpx;width:120rpx;height:120rpx;border-radius:50%;background:rgba(255,255,255,.12);display:flex;flex-direction:column;align-items:center;justify-content:center}.score-float text{font-size:48rpx;font-weight:800}.score-float small{font-size:17rpx;color:#B8C0D8}.feedback{position:absolute;bottom:30rpx;left:24rpx;right:24rpx;padding:22rpx;border-radius:20rpx;text-align:center;font-weight:700;background:rgba(36,177,133,.88)}.feedback.warning{background:rgba(255,111,0,.9)}.live-panel{margin:22rpx 18rpx;background:#fff;color:#182033;border-radius:28rpx;padding:26rpx}.live-row{display:flex;justify-content:space-between}.live-row view{display:flex;flex-direction:column;gap:6rpx}.label{font-size:19rpx;color:#8A93A6}.value{font-size:30rpx;font-weight:800}.progress{height:10rpx;background:#EEF0F4;border-radius:99rpx;margin-top:24rpx;overflow:hidden}.progress view{height:100%;background:#1A237E}.mode-row{display:flex;justify-content:space-between;font-size:19rpx;color:#1A237E;margin-top:18rpx}.stop{margin:0 18rpx;background:#fff;color:#1A237E;border-radius:18rpx}