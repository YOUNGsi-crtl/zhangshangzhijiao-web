.camera-box{height:760rpx;margin:28rpx 0;border-radius:32rpx;overflow:hidden;background:#17205F;position:relative}.camera{width:100%;height:100%;opacity:.88}.scan{position:absolute;left:8%;right:8%;top:22%;height:56%;border:2rpx solid rgba(184,215,255,.75);border-radius:28rpx}.human{position:absolute;left:50%;top:27%;width:220rpx;height:420rpx;transform:translateX(-50%);opacity:.7}.head{width:62rpx;height:62rpx;border:7rpx solid #B8D7FF;border-radius:50%;margin:0 auto}.body{width:10rpx;height:180rpx;background:#B8D7FF;margin:8rpx auto}.arm{position:absolute;width:150rpx;height:8rpx;background:#B8D7FF;top:76rpx}.arm.l{right:52%;transform:rotate(10deg);transform-origin:right}.arm.r{left:52%;transform:rotate(-10deg);transform-origin:left}.leg{position:absolute;width:8rpx;height:180rpx;background:#B8D7FF;top:260rpx}.leg.l{left:46%;transform:rotate(5deg)}.leg.r{right:46%;transform:rotate(-5deg)}.camera-tip{position:absolute;bottom:24rpx;left:0;right:0;text-align:center;color:#fff;font-size:23rpx}.checks{padding:10rpx 28rpx}.check{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #EEF0F4}.check:last-child{border:0}.ok{color:#15946B}.begin{height:90rpx;line-height:90rpx;margin-top:26rpx}