.detail-cover{height:360rpx;border-radius:32rpx;background:linear-gradient(145deg,#DDEBFF,#E8EAF6);display:flex;align-items:center;justify-content:center;font-size:76rpx;font-weight:800;color:#1A237E;position:relative}.ai-badge{position:absolute;left:24rpx;top:24rpx;background:#fff;color:#1A237E;border-radius:999rpx;padding:10rpx 18rpx;font-size:22rpx}.intro{margin-top:22rpx}.metrics{display:flex;margin-top:28rpx;padding-top:22rpx;border-top:1rpx solid #EEF0F4}.metrics view{flex:1;text-align:center;border-right:1rpx solid #EEF0F4}.metrics view:last-child{border:0}.metrics text{font-size:38rpx;font-weight:800;color:#1A237E;display:block}.metrics small{font-size:20rpx;color:#8A93A6}.move-list{padding:10rpx 24rpx}.move{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #F0F2F6}.move:last-child{border:0}.move .num{width:48rpx;height:48rpx;border-radius:50%;background:#EEF0FF;color:#1A237E;display:flex;align-items:center;justify-content:center;margin-right:18rpx}.move .muted{margin-left:auto}.begin{height:92rpx;line-height:92rpx;margin-top:30rpx}