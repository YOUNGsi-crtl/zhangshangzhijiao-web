.profile{display:flex;align-items:center;gap:20rpx}.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#DDEBFF;color:#1A237E;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:800}.profile>view:nth-child(2){display:flex;flex-direction:column;gap:10rpx}.name{font-size:34rpx;font-weight:800}.arrow{margin-left:auto;font-size:42rpx;color:#A1A8B8}.stats .card{min-height:150rpx;display:flex;flex-direction:column;justify-content:center;gap:10rpx}.num{font-size:44rpx;font-weight:900;color:#1A237E}.menu{padding:0 28rpx}.menu navigator{display:flex;justify-content:space-between;padding:30rpx 0;border-bottom:1rpx solid #EEF0F4}.menu navigator:last-child{border:0}