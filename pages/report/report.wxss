.report-head{text-align:center;padding:28rpx 0}.report-head .tag{display:inline-flex}.score{font-size:112rpx;font-weight:900;color:#1A237E;line-height:1.1;margin-top:16rpx}.summary{display:flex;justify-content:space-around;text-align:center;margin-top:10rpx}.summary view{display:flex;flex-direction:column;gap:8rpx;color:#8A93A6;font-size:20rpx}.metric{font-size:38rpx;font-weight:800;color:#182033}.bars{padding:22rpx 28rpx}.bar-row{display:grid;grid-template-columns:170rpx 1fr 55rpx;align-items:center;gap:14rpx;margin:22rpx 0;font-size:22rpx}.bar{height:14rpx;background:#EEF0F4;border-radius:99rpx;overflow:hidden}.bar view{height:100%;background:#1A237E;border-radius:99rpx}.error{display:flex;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #EEF0F4}.error:last-child{border:0}.error view{display:flex;flex-direction:column;gap:7rpx}.dot{width:48rpx;height:48rpx;border-radius:50%;background:#FFF0E5;color:#FF6F00;display:flex;align-items:center;justify-content:center}.advice{line-height:1.7;color:#536078}.begin{height:88rpx;line-height:88rpx;margin-top:30rpx}